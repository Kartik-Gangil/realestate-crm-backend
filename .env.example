# SMTP configuration for password-reset emails. Copy to .env and replace values.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@example.com
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password
# Required before integration credentials can be stored. Generate once and retain it.
INTEGRATION_ENCRYPTION_KEY=
ENVIRONMENT_NAME=development
