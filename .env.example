# Signing key. Required when DJANGO_DEBUG is off; generate a new one per environment.
DJANGO_SECRET_KEY=
# 1 for local development, 0 (the default) for production.
DJANGO_DEBUG=
# 1 to enforce HTTPS in production (the default); set 0 only for a domain-less beta on a static IP.
DJANGO_HTTPS=
# Comma-separated hostnames accepted by Django.
DJANGO_ALLOWED_HOSTS=
# Comma-separated browser origins allowed by CORS.
CORS_ALLOWED_ORIGINS=
# Comma-separated browser origins trusted for CSRF.
CSRF_TRUSTED_ORIGINS=
# 1 only when a trusted proxy supplies X-Forwarded-Proto.
DJANGO_TRUST_PROXY=
# Public API requests per client IP per minute.
RATE_LIMIT_PUBLIC_PER_MINUTE=
# Non-public API requests per client IP per minute.
RATE_LIMIT_API_PER_MINUTE=
# Minimum seconds between reminder scans in one worker process.
REMINDER_INTERVAL_SECONDS=
# Bearer token for the Prometheus /metrics endpoint; leave blank to disable it.
METRICS_TOKEN=
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
DJANGO_LOG_LEVEL=
# Django email backend.
EMAIL_BACKEND=
# SMTP host.
EMAIL_HOST=
# SMTP port.
EMAIL_PORT=
# SMTP username.
EMAIL_HOST_USER=
# SMTP password.
EMAIL_HOST_PASSWORD=
# 1 to enable SMTP TLS.
EMAIL_USE_TLS=
# Default sender address.
DEFAULT_FROM_EMAIL=
# Frontend URL used in password-reset links.
PASSWORD_RESET_FRONTEND_URL=
# PostgreSQL/Supabase connection string. Leave blank to use local SQLite.
DATABASE_URL=
# Inactivity window for server-side auth sessions, in minutes.
AUTH_SESSION_TIMEOUT_MINUTES=
# Lockout window after five consecutive failed passwords, in minutes.
AUTH_LOCKOUT_MINUTES=
# Email used by initialize_backend only when no Django superuser exists.
DJANGO_INITIAL_SUPERUSER_EMAIL=
# Password used by initialize_backend only when no Django superuser exists.
DJANGO_INITIAL_SUPERUSER_PASSWORD=
# Optional first name for the initial superuser.
DJANGO_INITIAL_SUPERUSER_FIRST_NAME=
# Optional last name for the initial superuser.
DJANGO_INITIAL_SUPERUSER_LAST_NAME=
# Key reserved for integration credential encryption.
INTEGRATION_ENCRYPTION_KEY=
# Deployment environment label.
ENVIRONMENT_NAME=
# Firebase project ID used by the Admin SDK for the email OTP challenge store.
FIREBASE_PROJECT_ID=
# Firebase service-account client email. Keep this backend-only.
FIREBASE_CLIENT_EMAIL=
# Firebase service-account private key. Use literal \\n characters for line breaks when stored in dotenv.
FIREBASE_PRIVATE_KEY=
# Firebase Realtime Database data URL; do not use a console.firebase.google.com URL.
FIREBASE_DATABASE_URL=
# Base64url of 32 random bytes; encrypts every stored file. Required when DJANGO_DEBUG is off. Back it up separately: without it the files can't be recovered.
FILE_ENCRYPTION_KEY=
# Folder for encrypted uploads (default: Backend/private_media). Never serve it from a web server.
PRIVATE_MEDIA_ROOT=
