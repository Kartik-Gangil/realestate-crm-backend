# Signing key. Required when DJANGO_DEBUG is off; generate a new one per environment.
DJANGO_SECRET_KEY=
# 1 for local development, 0 (the default) for production.
DJANGO_DEBUG=
# Comma-separated hostnames accepted by Django.
DJANGO_ALLOWED_HOSTS=
# Comma-separated browser origins allowed by CORS.
CORS_ALLOWED_ORIGINS=
# Comma-separated browser origins trusted for CSRF.
CSRF_TRUSTED_ORIGINS=
# 1 only when a trusted proxy supplies X-Forwarded-Proto.
DJANGO_TRUST_PROXY=
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
DJANGO_LOG_LEVEL=
# Django email backend.
EMAIL_BACKEND=
# SMTP host.
EMAIL_HOST=
# SMTP port.
EMAIL_PORT=
# SMTP username.
EMAIL_HOST_USER=
# SMTP password.
EMAIL_HOST_PASSWORD=
# 1 to enable SMTP TLS.
EMAIL_USE_TLS=
# Default sender address.
DEFAULT_FROM_EMAIL=
# Frontend URL used in password-reset links.
PASSWORD_RESET_FRONTEND_URL=
# Key reserved for integration credential encryption.
INTEGRATION_ENCRYPTION_KEY=
# Deployment environment label.
ENVIRONMENT_NAME=
# Base64url of 32 random bytes; encrypts every stored file. Required when DJANGO_DEBUG is off. Back it up separately: without it the files can't be recovered.
FILE_ENCRYPTION_KEY=
# Folder for encrypted uploads (default: Backend/private_media). Never serve it from a web server.
PRIVATE_MEDIA_ROOT=
